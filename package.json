{
  "name": "ask-a-brain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ask a Brain: a Market Harness for bounded, auditable purchases of expertise by AI agents (hackathon build).",
  "license": "MIT",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "node scripts/test/run.ts",
    "check:toolchain": "node scripts/assert-toolchain.ts",
    "check:secrets": "node scripts/check/secrets.ts",
    "check:boundaries": "node scripts/check/boundaries.ts",
    "check": "npm run check:toolchain && npm run typecheck && npm run check:boundaries && npm test && npm run check:secrets"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@solana/kit": "8.4.0",
    "canonicalize": "5.1.0",
    "jsonc-parser": "3.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.9.3"
  }
}
